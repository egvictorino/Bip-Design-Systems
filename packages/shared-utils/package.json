{
  "name": "@bip-design-systems/shared-utils",
  "version": "0.1.1",
  "description": "Bip Design Systems — Pure TypeScript utilities (formatting, validation)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/egvictorino/Bip-Design-Systems.git",
    "directory": "packages/shared-utils"
  },
  "bugs": {
    "url": "https://github.com/egvictorino/Bip-Design-Systems/issues"
  },
  "keywords": [
    "typescript",
    "utilities",
    "formatting",
    "validation",
    "mexico",
    "rfc"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:package": "publint && attw --pack . --ignore-rules cjs-resolves-to-esm"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@vitest/coverage-v8": "^4.1.10",
    "publint": "^0.3.23",
    "typescript": "5.3.3",
    "vitest": "^3.2.7"
  }
}
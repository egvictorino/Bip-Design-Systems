{
  "name": "@bip-design-systems/ui-components",
  "version": "0.4.0",
  "description": "BipUI — React component library",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/egvictorino/Bip-Design-Systems.git",
    "directory": "packages/ui-components"
  },
  "homepage": "https://egvictorino.github.io/Bip-Design-Systems/",
  "bugs": {
    "url": "https://github.com/egvictorino/Bip-Design-Systems/issues"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "ui",
    "typescript",
    "css-modules"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./*": {
      "types": "./dist/components/*/*.d.ts",
      "import": "./dist/components/*/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "browserslist": [
    "chrome >= 111",
    "safari >= 16.2",
    "firefox >= 113",
    "edge >= 111"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src visual .storybook --ext .ts,.tsx,.js,.jsx",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint:package": "publint && attw --pack . --exclude-entrypoints ./style.css --ignore-rules cjs-resolves-to-esm",
    "size": "size-limit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.12.1",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.62.1",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-links": "^10.5.7",
    "@storybook/react": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "3.5.9",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "happy-dom": "^20.8.9",
    "jest-axe": "11.0.0",
    "postcss": "^8.5.12",
    "publint": "^0.3.23",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "size-limit": "^11.2.0",
    "storybook": "^10.5.7",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.7"
  }
}
